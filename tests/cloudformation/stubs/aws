# Test stub for the AWS CLI. Logs every invocation to $AWS_STUB_LOG and returns
# canned responses driven by STUB_* environment variables, so the behavior tests
# can drive deploy.sh / teardown.sh through each ownership branch without AWS.
import os
import sys

args = sys.argv[1:]

log = os.environ.get("AWS_STUB_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(" ".join(args) + "\n")


def env(key, default=""):
    return os.environ.get(key, default)


svc = args[0] if args else ""
op = args[1] if len(args) > 1 else ""

if (svc, op) == ("sts", "get-caller-identity"):
    sys.stdout.write("111122223333\n")
    sys.exit(0)

# Marker so head-bucket reflects a create-bucket done earlier in the same run:
# once we create the bucket, we own it and the ownership check should pass.
created_marker = (log + ".created") if log else None


def _bucket_created():
    return created_marker and os.path.exists(created_marker)


if (svc, op) == ("s3api", "head-bucket"):
    code = env("STUB_HEAD", "0")  # "0" = owned by caller; "403"/"404" = error
    if code == "0" or _bucket_created():
        sys.exit(0)
    sys.stderr.write(
        f"An error occurred ({code}) when calling the HeadBucket operation\n"
    )
    sys.exit(254)

if (svc, op) == ("s3api", "create-bucket"):
    if env("STUB_CREATE", "ok") == "exists":  # name already taken elsewhere
        sys.stderr.write(
            "An error occurred (BucketAlreadyExists) when calling the "
            "CreateBucket operation\n"
        )
        sys.exit(254)
    if created_marker:
        open(created_marker, "w").close()
    sys.stdout.write('{"Location": "/stub"}\n')
    sys.exit(0)

if (svc, op) == ("s3api", "get-bucket-location"):
    sys.stdout.write(env("STUB_LOCATION", "us-west-1") + "\n")
    sys.exit(0)

if (svc, op) == ("cloudformation", "describe-stacks"):
    # teardown reads StagingBucketName / GraphId; "None" makes it skip those paths.
    sys.stdout.write("None\n")
    sys.exit(0)

# put-object, s3 rb/rm, cloudformation deploy/delete-stack/wait, neptune-graph, etc.
sys.exit(0)
