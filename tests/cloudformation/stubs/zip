# Test stub for `zip`: creates each target .zip argument so deploy.sh has an
# artifact to upload, without depending on the real zip binary or notebook files.
import pathlib
import sys

for arg in sys.argv[1:]:
    if arg.endswith(".zip"):
        target = pathlib.Path(arg)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.touch()
sys.exit(0)
