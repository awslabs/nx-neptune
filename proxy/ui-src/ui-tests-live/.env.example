# Settings for the live browser tests (make ui-browser-live).
# Keep your copy OUTSIDE the repository, and point the tests at it:
#   export E2E_ENV_FILE=/path/to/your/e2e.env
# That variable is the only place the tests read settings from. A value already exported in
# your shell wins over the file, except an empty one, which counts as unset.
# AWS credentials and region come from your shell, as for the proxy itself.
# Don't source or export this file: the tests load it themselves.

# --- Shared by all test cases ---
E2E_S3_BUCKET=                     # S3 staging bucket name (s3:// and a trailing / are accepted)
E2E_CATALOG=AwsDataCatalog         # Athena catalog
E2E_DATABASE=                      # Athena database
# E2E_PORT=18080                   # port of the test proxy (not 8080, so your dev proxy keeps running)
# E2E_PYTHON=python                # interpreter that has nx_neptune_proxy installed

# --- Test case: import (graph session and provisioned graph) ---
# Athena SQL, one line per query, wrapped in backticks so it can contain both ' and ".
# Backticks work only in this file; a shell would run them as a command.
# No "--" comments: on one line they would comment out the rest of the query.
E2E_IMPORT_NODE_QUERY=`SELECT id AS "~id", 'Label' AS "~label", name FROM my_nodes_table`
# E2E_IMPORT_EDGE_QUERY=`SELECT id AS "~id", src AS "~from", dst AS "~to", 'Label' AS "~label" FROM my_edges_table`   # optional
