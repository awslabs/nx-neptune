# Settings for the live browser tests (make ui-browser-live).
# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Values already exported in your shell win over this file.
# AWS credentials come from your shell, as for the proxy itself.

# --- Shared by all test cases ---
E2E_S3_BUCKET=                     # S3 staging bucket name, without s3://
E2E_CATALOG=AwsDataCatalog         # Athena catalog
E2E_DATABASE=                      # Athena database
# E2E_PORT=18080                   # port of the test proxy (not 8080, so your dev proxy keeps running)
# E2E_PYTHON=python                # interpreter that has nx_neptune_proxy installed

# --- Test case: import (graph session and provisioned graph) ---
# Files are relative to ui-tests-live/. Keep your real queries in data.local/ (git-ignored).
E2E_IMPORT_NODE_QUERY_FILE=data.local/import-nodes.sql
# E2E_IMPORT_EDGE_QUERY_FILE=data.local/import-edges.sql   # optional
